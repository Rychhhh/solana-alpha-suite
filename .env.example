# Paste your Helius Free API Key from https://dashboard.helius.dev -> API Keys
HELIUS_API_KEY=

# Path to your tracked wallets JSON (Axiom / Padre / GMGN export format)
WALLET_LIST_PATH=./wallets.json

# Local Server Port
PORT=3777

# Optional: Telegram Bot for Live Consensus Ping Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
